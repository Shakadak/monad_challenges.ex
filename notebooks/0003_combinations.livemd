## Generating combinations

https://mightybyte.github.io/monad-challenges/pages/ex3-1.html

DO NOT USE `for/1` or `Enum` or `List` for the exercise, please use explicit recursion.

```elixir
defmodule GeneratingCombinations do
  @spec allPairs([a], [b]) :: [{a, b}]
    when a: var, b: var
  def allPairs(_lefts, _rights) do
    
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule GeneratingCombinationsTest do
  use ExUnit.Case, async: true

  test "it works" do
    import GeneratingCombinations

    refute allPairs([1, 2, 3], [4, 5, 6]) == [{1, 4}, {2, 5}, {3, 6}]
    assert allPairs([1, 2], [3, 4]) == [{1, 3}, {1, 4}, {2, 3}, {2, 4}]

    assert allPairs(Enum.to_list(1..3), Enum.to_list(6..8)) ==
      [{1, 6}, {1, 7}, {1, 8}, {2, 6}, {2, 7}, {2, 8}, {3, 6}, {3, 7}, {3, 8}]
  end
end

ExUnit.run()
```

## Poker hands

https://mightybyte.github.io/monad-challenges/pages/ex3-2.html

```elixir
import MCPrelude
import GeneratingCombinations

allPairs(cardRanks(), cardSuits())
```

```elixir
defmodule Card do
  defstruct []
  
  defimpl Inspect do
    def inspect(_, _opts) do
      
    end
  end
end

defmodule PokerHands do
  @spec allCards([integer], [binary]) :: [Card.t]
  def allCards(_ranks, _suits) do
    
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule PokerHandsTest do
  use ExUnit.Case, async: true

  test "it works" do
    import MCPrelude
    import PokerHands

    assert inspect(allCards(cardRanks(), cardSuits())) ==
      "[2H, 2D, 2C, 2S, 3H, 3D, 3C, 3S, 4H, 4D, 4C, 4S, 5H, 5D, 5C, 5S]"
  end
end

ExUnit.run()
```
