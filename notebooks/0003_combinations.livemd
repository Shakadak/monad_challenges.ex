## Generating combinations

https://mightybyte.github.io/monad-challenges/pages/ex3-1.html

DO NOT USE `for/1` or `Enum` or `List` for the exercise, please use explicit recursion.

```elixir
defmodule GeneratingCombinations do
  @spec allPairs([a], [b]) :: [{a, b}]
    when a: var, b: var
  def allPairs(_lefts, _rights) do
    
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule GeneratingCombinationsTest do
  use ExUnit.Case, async: true

  test "it works" do
    import GeneratingCombinations

    refute allPairs([1, 2, 3], [4, 5, 6]) == [{1, 4}, {2, 5}, {3, 6}]
    assert allPairs([1, 2], [3, 4]) == [{1, 3}, {1, 4}, {2, 3}, {2, 4}]

    assert allPairs(Enum.to_list(1..3), Enum.to_list(6..8)) ==
      [{1, 6}, {1, 7}, {1, 8}, {2, 6}, {2, 7}, {2, 8}, {3, 6}, {3, 7}, {3, 8}]
  end
end

ExUnit.run()
```

## Poker hands

https://mightybyte.github.io/monad-challenges/pages/ex3-2.html

```elixir
GeneratingCombinations.allPairs(MCPrelude.cardRanks(), MCPrelude.cardSuits())
```

```elixir
defmodule Card do
  defstruct []
  
  defimpl Inspect do
    def inspect(_, _opts) do
      
    end
  end
end

defmodule PokerHands do
  @spec allCards([integer], [binary]) :: [Card.t]
  def allCards(_ranks, _suits) do
    
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule PokerHandsTest do
  use ExUnit.Case, async: true

  test "it works" do
    import MCPrelude
    import PokerHands

    assert inspect(allCards(cardRanks(), cardSuits())) ==
      "[2H, 2D, 2C, 2S, 3H, 3D, 3C, 3S, 4H, 4D, 4C, 4S, 5H, 5D, 5C, 5S]"
  end
end

ExUnit.run()
```

## Generalizing pairs and cards

https://mightybyte.github.io/monad-challenges/pages/ex3-3.html

```elixir
defmodule GeneralizingPairsAndCards do
  @spec allCombs((a, b -> c), [a], [b]) :: [c]
    when a: var, b: var, c: var
  def allCombs(_, _, _) do
    
  end

  def allPairs(_, _) do
    
  end

  def allCards(_, _) do
    
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule GeneralizingPairsAndCardsTest do
  use ExUnit.Case, async: true

  test "it works" do
    import MCPrelude
    import GeneralizingPairsAndCards

    assert allPairs([1, 2, 3], [4, 5, 6]) ==
      GeneratingCombinations.allPairs([1, 2, 3], [4, 5, 6])
    assert allPairs([1, 2], [3, 4]) ==
      GeneratingCombinations.allPairs([1, 2], [3, 4])

    assert allPairs(Enum.to_list(1..3), Enum.to_list(6..8)) ==
      GeneratingCombinations.allPairs(Enum.to_list(1..3), Enum.to_list(6..8))

    assert allCards(cardRanks(), cardSuits()) ==
      PokerHands.allCards(cardRanks(), cardSuits())
  end
end

ExUnit.run()
```

## Combinations of three things

https://mightybyte.github.io/monad-challenges/pages/ex3-4.html

```elixir
defmodule CombinationsOfThreeThings do
  @spec allCombs3((a, b, c -> d), [a], [b], [c]) :: [d]
    when a: var, b: var, c: var, d: var
  def allCombs3(_, _, _, _) do
    []
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule CombinationsOfThreeThingsTest do
  use ExUnit.Case, async: true

  test "it works" do
    import CombinationsOfThreeThings

    assert allCombs3(&{&1, &2, &3}, [1, 2], [3, 4], [5, 6]) ==
      [
        {1, 3, 5},
        {1, 3, 6},
        {1, 4, 5},
        {1, 4, 6},
        {2, 3, 5},
        {2, 3, 6},
        {2, 4, 5},
        {2, 4, 6}
      ]

  end
end

ExUnit.run()
```

