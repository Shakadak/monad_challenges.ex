```elixir
ExUnit.start(autorun: false)

defmodule CVTest do
  use ExUnit.Case, async: true

  test "it works" do
    import MCPrelude
    import CV
    import Maybe

    assert addSalaries(salaries(), "alice", "bob") == just(195000)
    assert addSalaries(salaries(), "carol", "dave") == nothing()

    assert addSalaries2(salaries(), "alice", "bob") == just(195000)
    assert addSalaries2(salaries(), "carol", "dave") == nothing()
  end
end

ExUnit.run()
```

## Tailprod

https://mightybyte.github.io/monad-challenges/pages/ex2-6.html

```elixir
defmodule Tailprod do
  @spec tailProd([number]) :: Maybe.t(number)
  def tailProd(_) do
    
  end
  
  @spec tailSum([number]) :: Maybe.t(number)
  def tailSum(_) do
    
  end

  def transMaybe do
    
  end

  def tailMax do
    
  end

  def tailMin do
    
  end

  def combine do
    
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule TailprodTest do
  use ExUnit.Case, async: true

  test "it works" do
    import Maybe
    import Tailprod

    assert tailProd([]) == nothing()
    assert tailProd([42]) == just(1)
    assert tailProd([42, 43, 45]) == just(1 * 43 * 45)

    assert tailSum([]) == nothing()
    assert tailSum([42]) == just(0)
    assert tailSum([42, 43, 45]) == just(0 + 43 + 45)
  end

  test "tailMax & tailMin & combine" do
    import Maybe
    import Tailprod

    assert combine(tailMax([])) == nothing()
    assert combine(tailMax([1])) == nothing()
    assert combine(tailMax([1, 2, 3])) == just(3)

    assert combine(tailMin([])) == nothing()
    assert combine(tailMin([1])) == nothing()
    assert combine(tailMin([1, 2, 3])) == just(2)
  end
end

ExUnit.run()
```

