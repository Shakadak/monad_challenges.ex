## The Maybe Type

https://mightybyte.github.io/monad-challenges/pages/ex2-1.html

This part can be cheated a bit for the data type declaration, because Elixir can't really produce an equivalent.

```elixir
defmodule Maybe do
  defstruct []

  defmacro just(_) do
    
  end

  defmacro nothing do
    
  end

  defimpl Inspect do
    @spec inspect(Maybe.t(a), Inspect.Opts.t) :: String.t
     when a: any # a is expected to implement the Inspect protocol
    def inspect(%@for{} = _maybe, _opts) do
      raise UndefinedFunctionError
    end
  end

  def eq(%__MODULE__{}, %__MODULE__{}) do

  end
end
```

## Build a library of things that can fail

https://mightybyte.github.io/monad-challenges/pages/ex2-2.html

```elixir
defmodule MaybeLib do
  @spec headMay([a]) :: Maybe.t(a)
    when a: var
  def headMay(_) do

  end

  @spec tailMay([a]) :: Maybe.t(a)
    when a: var
  def tailMay(_) do

  end

  @spec lookupMay(a, [{a, b}]) :: Maybe.t(b)
    when a: var, b: var
  def lookupMay(_, _) do

  end

  @spec divMay(float, float) :: Maybe.t(float)
  def divMay(_, _) do

  end

  @spec maximumMay([a]) :: Maybe.t(a)
    when a: var
  def maximumMay(_) do

  end

  @spec minimumMay([a]) :: Maybe.t(a)
    when a: var
  def minimumMay(_) do
```

```elixir
ExUnit.start(autorun: false)

defmodule MaybeLibTest do
  use ExUnit.Case, async: true

  test "it works" do
    import Maybe

    assert MaybeLib.headMay([1, 2, 3]) == just(1)
    assert MaybeLib.headMay([]) == nothing()

    assert MaybeLib.tailMay([1, 2, 3]) == just([2, 3])
    assert MaybeLib.tailMay([]) == nothing()

    assert MaybeLib.lookupMay("banana", []) == nothing()
    assert MaybeLib.lookupMay("banana", [{"banana", "split"}]) == just("split")

    assert MaybeLib.divMay(1, 0) == nothing()
    assert MaybeLib.divMay(1, 2) == just(0.5)

    assert MaybeLib.minimumMay([1, 2, 3]) == just(1)
    assert MaybeLib.minimumMay([]) == nothing()

    assert MaybeLib.maximumMay([1, 2, 3]) == just(3)
    assert MaybeLib.maximumMay([]) == nothing()
  end
end

ExUnit.run()
```

## Chains of Failing Computations

https://mightybyte.github.io/monad-challenges/pages/ex2-3.html

```elixir
defmodule CFC do
  @spec queryGreek(MCPrelude.greekData, binary) :: Maybe.t(float)
  def queryGreek(_greek_data, _str) do

  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule CFCTest do
  use ExUnit.Case, async: true

  test "it works" do
    import MCPrelude
    import CFC
    import Maybe

    assert queryGreek(greekDataA(), "alpha") == just(2.0)
    assert queryGreek(greekDataA(), "beta") == nothing()
    assert queryGreek(greekDataA(), "gamma") == just(3.3333333333333335)
    assert queryGreek(greekDataA(), "delta") == nothing()
    assert queryGreek(greekDataA(), "zeta") == nothing()

    assert queryGreek(greekDataB(), "rho") == nothing()
    assert queryGreek(greekDataB(), "phi") == just(0.24528301886792453)
    assert queryGreek(greekDataB(), "chi") == just(9.095238095238095)
    assert queryGreek(greekDataB(), "psi") == nothing()
    assert queryGreek(greekDataB(), "omega") == just(24.0)
  end
end

ExUnit.run()
```

