```elixir
ExUnit.start(autorun: false)

defmodule GCFTest do
  use ExUnit.Case, async: true

  test "it works" do
    import MCPrelude
    import GCF
    import Maybe

    assert queryGreek2(greekDataA(), "alpha") == just(2.0)
    assert queryGreek2(greekDataA(), "beta") == nothing()
    assert queryGreek2(greekDataA(), "gamma") == just(3.3333333333333335)
    assert queryGreek2(greekDataA(), "delta") == nothing()
    assert queryGreek2(greekDataA(), "zeta") == nothing()

    assert queryGreek2(greekDataB(), "rho") == nothing()
    assert queryGreek2(greekDataB(), "phi") == just(0.24528301886792453)
    assert queryGreek2(greekDataB(), "chi") == just(9.095238095238095)
    assert queryGreek2(greekDataB(), "psi") == nothing()
    assert queryGreek2(greekDataB(), "omega") == just(24.0)
  end
end

ExUnit.run()
```

