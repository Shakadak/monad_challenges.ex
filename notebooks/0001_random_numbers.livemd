## Random Number Generation

https://mightybyte.github.io/monad-challenges/pages/ex1-1.html

```elixir
defmodule RNG1_1 do
  import MCPrelude

  @doc """
      iex> Enum.product(#{__MODULE__}.fiveRands())
      8681089573064486461641871805074254223660
  """
  @spec fiveRands :: [integer()]
  def fiveRands do
  end
end
```

## Random Character Generation

https://mightybyte.github.io/monad-challenges/pages/ex1-2.html

```elixir
defmodule RCG1_2 do
  import MCPrelude

  @spec randLetter(MCPrelude.seed()) :: {char(), MCPrelude.seed()}
  def randLetter(seed) do
  end

  @doc """
      iex> Base.encode16(:crypto.hash(:sha256, #{__MODULE__}.randString3()), case: :lower)
      "9d475eb78d3e38085220ed6ebde9d8f7d26540bb1c8f9382479c3acd4c8c94a3"
  """
  @spec randString3 :: binary()
  def randString3 do
    # remember you can use the binary syntax to transform a character to a binary:
    # <<?a,?b>> == "ab"
  end
end
```

