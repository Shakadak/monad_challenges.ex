```

## Random Number Generation

https://mightybyte.github.io/monad-challenges/pages/ex1-1.html

```elixir
defmodule RNG1_1 do
  import MCPrelude, only: [
    mkSeed: 1,
    rand: 1,
  ]

  @doc """
      iex> Enum.product(#{__MODULE__}.fiveRands())
      8681089573064486461641871805074254223660
  """
  @spec fiveRands :: [integer()]
  def fiveRands do
  end
end
```

## Random Character Generation

https://mightybyte.github.io/monad-challenges/pages/ex1-2.html

```elixir
defmodule RCG1_2 do
  import MCPrelude, only: [
    mkSeed: 1,
    rand: 1,
    toLetter: 1,
  ]

  @spec randLetter(MCPrelude.seed()) :: {char(), MCPrelude.seed()}
  def randLetter(seed) do
  end

  @doc """
      iex> Base.encode16(:crypto.hash(:sha256, #{__MODULE__}.randString3()), case: :lower)
      "9d475eb78d3e38085220ed6ebde9d8f7d26540bb1c8f9382479c3acd4c8c94a3"
  """
  @spec randString3 :: binary()
  def randString3 do
    # remember you can use the binary syntax to transform a character to a binary:
    # <<?a,?b>> == "ab"
  end
end
```

## More Generators

https://mightybyte.github.io/monad-challenges/pages/ex1-3.html

```elixir
defmodule MG1_3 do
  import MCPrelude, only: [
    rand: 1,
  ]

  # @spec rand(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  # @spec randLetter(MCPrelude.seed()) :: {char(), MCPrelude.seed()}
  # ====>
  # @spec rand :: gen(integer())
  # @spec randLetter :: gen(char())

  # TODO fix this type synonym
  @type gen(val) :: [val]
  # Use it as a thought exercise, Elixir is not capable to
  # represent an actual use of `gen(type)` as a spec.
  # Well, it can if you do partial currying yourself.

  # define the arguments and spec yourself
  def generalA do
    # ???
  end

  @spec randEven(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  def randEven(seed) do
    # generalA ?
  end

  @spec randOdd(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  def randOdd(seed) do
    # generalA ?
  end

  @spec randTen(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  def randTen(seed) do
    # generalA ?
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule MG1_3Test do
  use ExUnit.Case, async: true

  test "it works" do
    {even, _} = MG1_3.randEven(MCPrelude.mkSeed(1))
    {odd, _} = MG1_3.randOdd(MCPrelude.mkSeed(1))
    {ten, _} = MG1_3.randTen(MCPrelude.mkSeed(1))
    assert even * odd * ten == 189908109902700
  end
end

ExUnit.run()
```

