  @spec randEven(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  def randEven(seed) do
    # generalA ?
  end

  @spec randOdd(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  def randOdd(seed) do
    # generalA ?
  end

  @spec randTen(MCPrelude.seed()) :: {integer(), MCPrelude.seed()}
  def randTen(seed) do
    # generalA ?
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule MG1_3Test do
  use ExUnit.Case, async: true

  test "it works" do
    {even, _} = MG1_3.randEven(MCPrelude.mkSeed(1))
    {odd, _} = MG1_3.randOdd(MCPrelude.mkSeed(1))
    {ten, _} = MG1_3.randTen(MCPrelude.mkSeed(1))
    assert even * odd * ten == 189908109902700
  end
end

ExUnit.run()
```

## Generalizing Random Pairs

https://mightybyte.github.io/monad-challenges/pages/ex1-4.html

```elixir
defmodule GRP1_4 do
  import MCPrelude, only: [
    rand: 1,
  ]

  import RCG1_2, only: [
    randLetter: 1,
  ]

  @doc """
      iex> elem(#{__MODULE__}.randPair(MCPrelude.mkSeed(1)), 0)
      {?l, 282475249}
  """
  @spec randPair(MCPrelude.seed()) :: {{char(), integer()}, MCPrelude.seed()}
  def randPair(seed) do
  end

  @type gen(type) :: (MCPrelude.seed() -> {type, MCPrelude.seed()})

  @spec generalizedPair(gen(a), gen(b)) :: gen({a, b}) when a: var, b: var
  def generalizedPair(left, right) do
  end

  @spec generalizedPair(
    (MCPrelude.seed() -> {a, MCPrelude.seed()}),
    (MCPrelude.seed() -> {b, MCPrelude.seed()}),
    MCPrelude.seed()
  ) :: {{a, b}, MCPrelude.seed()}
    when a: var, b: var
  def generalizedPair(left, right, seed) do
  end

  @doc """
      iex> elem(#{__MODULE__}.randPair_(MCPrelude.mkSeed(1)), 0)
      {?l, 282475249}
  """
  @spec randPair_(MCPrelude.seed()) :: {{char(), integer()}, MCPrelude.seed()}
  def randPair_(seed) do
  end
end
```

## Generalizing Pairs Even More

```elixir
defmodule GPEM1_4 do
  def generalB(in1, in2, cons, seed) do
  end

  def generalPair2(left, right, seed) do
  end

  @doc """
      iex> elem(#{__MODULE__}.randPair(MCPrelude.mkSeed(1)), 0)
      {?l, 282475249}
  """
  def randPair(seed) do
    generalPair2(&RCG1_2.randLetter/1, &MCPrelude.rand/1, seed)
  end
end
```

## Generalizing Lists of Generators

https://mightybyte.github.io/monad-challenges/pages/ex1-5.html

```elixir
defmodule GLG1_5 do
  @type gen(type) :: (MCPrelude.seed() -> {type, MCPrelude.seed()})
  
  @spec repRandom([gen(a)], MCPrelude.seed()) :: {[a], MCPrelude.seed()}
  def repRandom(gs, seed) do
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule GLG1_5Test do
  use ExUnit.Case, async: true

  test "it works" do
    seed = MCPrelude.mkSeed(1)
    {cs, _seed} = GLG1_5.repRandom(List.duplicate(&RCG1_2.randLetter/1, 3), seed)
    assert to_string(cs) == RCG1_2.randString3()
  end
end

ExUnit.run()
```

