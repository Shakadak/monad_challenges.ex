## Generalizing Random Pairs : Curried

https://mightybyte.github.io/monad-challenges/pages/ex1-4.html

```elixir
defmodule GRP1_4.Curried do
  import MCPrelude, only: [
    rand: 1,
  ]

  import RCG1_2, only: [
    randLetter: 1,
  ]

  # TODO fix this type synonym
  @type gen(val) :: [val]

  # @type gen(type) :: (MCPrelude.seed() -> {type, MCPrelude.seed()})

  @spec randLetter :: gen(char())
  def randLetter do
    &randLetter/1
  end

  @doc """
      iex> elem(#{__MODULE__}.randPair.(MCPrelude.mkSeed(1)), 0)
      {?l, 282475249}
  """
  @spec randPair :: gen({char(), integer()})
  def randPair do
    fn seed ->
    end
  end

  @spec generalPair(gen(a), gen(b)) :: gen({a, b}) when a: var, b: var
  def generalPair(left, right) do
    fn seed ->
    end
  end

  @doc """
      iex> elem(#{__MODULE__}.randPair_.(MCPrelude.mkSeed(1)), 0)
      {?l, 282475249}
  """
  @spec randPair_ :: gen({char(), integer()})
  def randPair_ do
  end
end
```

## Generalizing Pairs Even More

```elixir
defmodule GPEM1_4 do
  # define the arguments and spec yourself
  def generalB do
    # ????
  end

  def generalB(in1, in2, cons, seed) do
  end

  def generalPair2(left, right, seed) do
  end

  @doc """
      iex> elem(#{__MODULE__}.randPair(MCPrelude.mkSeed(1)), 0)
      {?l, 282475249}
  """
  def randPair(seed) do
    generalPair2(&RCG1_2.randLetter/1, &MCPrelude.rand/1, seed)
  end
end
