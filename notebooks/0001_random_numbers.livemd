## Generalizing Lists of Generators

https://mightybyte.github.io/monad-challenges/pages/ex1-5.html

```elixir
defmodule GLG1_5 do
  # TODO fix this type synonym
  @type gen(val) :: [val]
  
  @spec repRandom([gen(a)], MCPrelude.seed()) :: {[a], MCPrelude.seed()}
    when a: var
  def repRandom(gs, seed) do
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule GLG1_5Test do
  use ExUnit.Case, async: true

  test "it works" do
    seed = MCPrelude.mkSeed(1)
    {cs, _seed} = GLG1_5.repRandom(List.duplicate(&RCG1_2.randLetter/1, 3), seed)
    assert to_string(cs) == RCG1_2.randString3()
  end
end

ExUnit.run()
```

<!-- livebook:{"branch_parent_index":8} -->

## Generalizing Lists of Generators : Curried

https://mightybyte.github.io/monad-challenges/pages/ex1-5.html

```elixir
defmodule GLG1_5.Curried do

  # TODO fix this type synonym
  @type gen(val) :: [val]

  @spec repRandom([gen(a)]) :: gen([a])
    when a: var
  def repRandom(gs) do
    fn seed ->
    end
  end
end
```

```elixir
ExUnit.start(autorun: false)

defmodule GLG1_5.CurriedTest do
  use ExUnit.Case, async: true

  test "it works" do
    seed = MCPrelude.mkSeed(1)
    gens = List.duplicate(GRP1_4.Curried.randLetter(), 3)
    {cs, _seed} = GLG1_5.Curried.repRandom(gens).(seed)
    assert to_string(cs) == RCG1_2.randString3()
  end
end

ExUnit.run()
```

